      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"bool_global_settings\" (\"name\" TEXT NOT NULL, \"value\" INTEGER NOT NULL CHECK (\"value\" IN (0, 1)), PRIMARY KEY (\"name\"));"
