    {
      "name": "accounts",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"accounts\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"realm_url\" TEXT NOT NULL, \"realm_name\" TEXT NULL, \"realm_icon\" TEXT NULL, \"user_id\" INTEGER NOT NULL, \"device_id\" INTEGER NULL, \"email\" TEXT NOT NULL, \"api_key\" TEXT NOT NULL, \"zulip_version\" TEXT NOT NULL, \"zulip_merge_base\" TEXT NULL, \"zulip_feature_level\" INTEGER NOT NULL, \"possible_legacy_push_token\" INTEGER NOT NULL DEFAULT 1 CHECK (\"possible_legacy_push_token\" IN (0, 1)), UNIQUE (\"realm_url\", \"user_id\"), UNIQUE (\"realm_url\", \"email\"));"
        }
      ]
    },
    {
      "name": "push_keys",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"push_keys\" (\"push_key_id\" INTEGER NOT NULL, \"push_key\" BLOB NOT NULL, \"account_id\" INTEGER NOT NULL REFERENCES accounts (id) ON DELETE CASCADE, \"created_timestamp\" INTEGER NOT NULL, \"superseded_timestamp\" INTEGER NULL, UNIQUE (\"push_key_id\"));"
        }
      ]
    },
    {
      "name": "server_snapshots",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"server_snapshots\" (\"account_id\" INTEGER NOT NULL REFERENCES accounts (id) ON DELETE CASCADE, \"queue_id\" TEXT NOT NULL, \"last_event_id\" INTEGER NOT NULL, \"app_version\" TEXT NOT NULL, \"timestamp\" INTEGER NOT NULL, \"event_log_truncated\" INTEGER NOT NULL DEFAULT 0 CHECK (\"event_log_truncated\" IN (0, 1)), PRIMARY KEY (\"account_id\"));"
        }
      ]
    },
    {
      "name": "server_snapshot_blobs",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"server_snapshot_blobs\" (\"account_id\" INTEGER NOT NULL REFERENCES accounts (id) ON DELETE CASCADE, \"data\" BLOB NOT NULL, PRIMARY KEY (\"account_id\"));"
        }
      ]
    },
