          "sql": "CREATE TABLE IF NOT EXISTS \"global_settings\" (\"theme_setting\" TEXT NULL, \"browser_preference\" TEXT NULL, \"visit_first_unread\" TEXT NULL, \"mark_read_on_scroll\" TEXT NULL, \"legacy_upgrade_state\" TEXT NULL);"
